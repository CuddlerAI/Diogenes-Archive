{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dm-gta-scenario/1",
  "type": "object",
  "required": [
    "schema", "scenario_id", "mode", "seed", "location", "clock", "radio",
    "weather", "source_epoch", "player", "dynamics", "replay", "effect_exclusions"
  ],
  "properties": {
    "schema": {"const": "dm-gta-scenario/1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "mode": {"const": "story_mode"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "location": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number"}
    },
    "radio": {"const": "off"},
    "weather": {"type": "string", "pattern": "^[A-Z][A-Z_]*$"},
    "clock": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "source_epoch": {"type": "string", "minLength": 1},
    "player": {
      "type": "object",
      "required": ["model", "control", "route_kind", "distance_m", "speed_mps", "heading_deg"],
      "properties": {
        "model": {"const": "current_story_player"},
        "control": {"const": "native_task_go_straight"},
        "route_kind": {"const": "forward_from_anchor"},
        "distance_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "speed_mps": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "heading_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360}
      }
    },
    "dynamics": {"type": "array", "minItems": 1, "maxItems": 1},
    "replay": {
      "type": "object",
      "required": ["duration_s", "warmup_s", "fps"],
      "properties": {"fps": {"const": 30}}
    },
    "effect_exclusions": {"type": "array", "items": {"type": "string"}}
  }
}
