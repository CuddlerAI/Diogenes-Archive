          "fy": {
            "type": "number"
          },
          "cx": {
            "type": "number"
          },
          "cy": {
            "type": "number"
          }
        }
      },
      "camera_speed": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "camera_rotation_oula": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "player_position": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "player_rotation_oula": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "player_rotation_quaternion": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "player_speed": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "mouse_x": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "mouse_y": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "mouse_dx": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "mouse_dy": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "keyCode": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "metric_scale": {
        "type": "number"
      }
    },
    "additionalProperties": true
