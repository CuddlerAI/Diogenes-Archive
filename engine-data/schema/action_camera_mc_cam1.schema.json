{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "69 MC action_camera cam1（主相机：蓝+白全字段；键名以需求方样例为准，含 'camera_Follow Offset' 空格键名）",
  "type": "array",
  "items": {
    "type": "object",
