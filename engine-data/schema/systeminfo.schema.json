{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "systeminfo（两单共用；分辨率按画幅如实填，竖屏为 1080x1920 等 1080P 档位）",
  "type": "object",
  "required": [
    "gameProcessName",
    "x",
    "y",
    "width",
    "height",
    "recordDpi"
  ],
  "properties": {
    "gameProcessName": {
      "type": "string"
    },
    "x": {
      "type": "integer"
    },
    "y": {
      "type": "integer"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "recordDpi": {
      "type": "number",
      "minimum": 0.5
    }
  }
}
