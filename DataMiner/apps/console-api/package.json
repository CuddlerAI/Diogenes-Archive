{
  "name": "@dataminer/console-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "bootstrap-operator": "tsx src/bootstrap-operator.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:postgres": "tsx scripts/verify-against-postgres.ts"
  },
  "dependencies": {
    "@dataminer/api": "workspace:*",
    "@dataminer/mirror": "workspace:*",
    "@aws-sdk/client-s3": "3.1092.0",
    "@aws-sdk/s3-request-presigner": "3.1092.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
