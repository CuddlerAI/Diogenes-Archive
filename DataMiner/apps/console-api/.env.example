# The console follows the ingest API: production startup is rejected in code.
# capture mail mode writes codes to disk and is refused outside development.
CONSOLE_ENV=development
DATABASE_URL=postgres://dataminer_console:replace-me@127.0.0.1:5432/dataminer_staging
HOST=127.0.0.1
PORT=8090
CONSOLE_PUBLIC_ORIGIN=http://localhost:5174
CONSOLE_IP_HASH_SALT=replace-me-with-32-plus-random-bytes
# Shared with the console Worker's CONSOLE_PROXY_TOKEN secret. Gates /console/v1/*
# only — /app/v1/* is reached directly by the desktop client (docs/11 §4.3).
# Optional in development (unset = gate open); required in staging.
CONSOLE_PROXY_TOKEN=

# How many proxy hops in front of this service are ours, counted inwards. This
# is the only thing that decides the client address, and the per-IP rate limits,
# annotator_invite_uses.ip_hash and the audit trail all read it.
#
# 1 = Cloud Run reached directly, which is how /app/v1 is reached.
#
# /console/v1 comes through the Worker and so sits one hop further out, but this
# is process-wide: at 1 the console's per-IP bucket resolves the Worker's egress
# address rather than the operator's — coarser, not forgeable, and its per-email
# bucket and account lockout are unaffected. Raising it to 2 would sharpen that
# and simultaneously let any /app/v1 caller pick its own bucket, which is the
# hole this setting exists to close. Do not raise it to sharpen console limiting.
#
# To check a deployment: call an /app/v1 endpoint with a bogus X-Forwarded-For
# prefix and confirm the rate limit bucket does not move.
CONSOLE_TRUSTED_PROXY_HOPS=1

# Login layering (docs/20 §6.A / §6.D). password_only (the default) = single
# factor: a correct password issues a session directly. password_otp = the
# two-step fallback (password then a mandatory email OTP). cf_access = the console
# has no password step; it verifies the Cloudflare Access assertion in front of it
# and issues a session for an allow-listed admin, so passing Access is the single
# sign-in. cf_access needs the three CONSOLE_CF_ACCESS_* values below.
CONSOLE_LOGIN_MODE=password_only
# Only for CONSOLE_LOGIN_MODE=cf_access. Team domain = the Access JWT issuer; AUD =
# the Access application's Application Audience tag; admin emails = the console-side
# allowlist (defence in depth over the Access policy) and JIT-provisioned as admin.
CONSOLE_CF_ACCESS_TEAM_DOMAIN=
CONSOLE_CF_ACCESS_AUD=
CONSOLE_CF_ACCESS_ADMIN_EMAILS=

CONSOLE_MAIL_MODE=capture
CONSOLE_MAIL_FROM=no-reply@mail.diogenesmodel.com
CONSOLE_MAIL_CAPTURE_DIR=./.mail-outbox
# CONSOLE_MAIL_API_KEY is required when CONSOLE_MAIL_MODE=resend.
CONSOLE_MAIL_API_KEY=
# Required in staging: only these addresses or domains can receive operator mail.
CONSOLE_MAIL_ALLOWLIST=

CONSOLE_SESSION_ABSOLUTE_MINUTES=720
CONSOLE_SESSION_IDLE_MINUTES=60
CONSOLE_SUDO_MINUTES=15

# Annotator sessions slide instead of expiring on a clock (docs/34 §6.1a):
# each authenticated use pushes expiry back out to this window, so only real
# inactivity — or logout / password change / suspension — ends a session.
# Operator sessions keep the absolute/idle knobs above.
CONSOLE_APP_SESSION_SLIDING_DAYS=30

CONSOLE_OTP_TTL_MINUTES=10
CONSOLE_OTP_MAX_ATTEMPTS=5
CONSOLE_INVITE_TTL_HOURS=24
CONSOLE_PASSWORD_RESET_TTL_MINUTES=30
CONSOLE_PASSWORD_MIN_LENGTH=12

CONSOLE_OTP_SEND_PER_MINUTE=1
CONSOLE_OTP_SEND_PER_HOUR=5
CONSOLE_OTP_SEND_PER_DAY=20
CONSOLE_OTP_SEND_PER_IP_HOUR=10
CONSOLE_LOGIN_PER_IP_HOUR=30
CONSOLE_LOGIN_PER_EMAIL_HOUR=30
CONSOLE_LOGIN_LOCK_THRESHOLD=10
CONSOLE_LOGIN_LOCK_BASE_MINUTES=15
CONSOLE_LOGIN_LOCK_MAX_MINUTES=240

# Clip preview. All five values or none: a partial configuration is rejected at
# startup rather than silently disabling preview. These credentials must be
# read-only and separate from the ingest write keys so they can be revoked alone.
CONSOLE_R2_ACCOUNT_ID=
CONSOLE_R2_BUCKET=
CONSOLE_R2_ACCESS_KEY_ID=
CONSOLE_R2_SECRET_ACCESS_KEY=
CONSOLE_R2_PREFIX=raw-staging/v1/non-trainable/dataminer-api-staging
CONSOLE_PREVIEW_TTL_SECONDS=300

# Data-review surface (docs/33). All four values or none, same discipline as
# preview. The credential is a THIRD token — Object Read only, scoped to exactly
# the buckets named in the sources — independent from both the ingest write keys
# and the preview key. CONSOLE_REVIEW_SOURCES is a JSON array; its prefixes are
# a hard allowlist and dbAuthority says whether this console's own database is
# the registration authority for the bucket ("production") or the registry
# lives in another environment's database ("none", e.g. the e2e bucket).
CONSOLE_REVIEW_R2_ACCOUNT_ID=
CONSOLE_REVIEW_R2_ACCESS_KEY_ID=
CONSOLE_REVIEW_R2_SECRET_ACCESS_KEY=
CONSOLE_REVIEW_SOURCES=[{"id":"raw-prod","bucket":"diogenes-model-training","prefixes":["raw/","raw-staging/","training/"],"dbAuthority":"production"},{"id":"training-dev","bucket":"diogenes-training-dev","prefixes":["raw/","method-validation/"],"dbAuthority":"none"},{"id":"depth-temp","bucket":"diogenes-tempbucket","prefixes":["depth-formal-20260804-195844/"],"dbAuthority":"none"},{"id":"depth-delivery","bucket":"diogenes-depth-delivery","prefixes":["verified/","viz/"],"dbAuthority":"none"}]
CONSOLE_REVIEW_TTL_SECONDS=300

# HF release reconciliation (docs/33 §6). Both or neither. The token is a
# fine-grained READ-ONLY HF token; the repos list is a hard allowlist —
# reconcile refuses anything not on it.
CONSOLE_HF_TOKEN=
CONSOLE_HF_REPOS=["DiogenesLab/gameplay-teaser"]

# Annotator surface (docs/11). Leave all five blank to run the governance
# console alone; set all five to serve /app/v1 signup/login/enroll. The database
# URL uses the dataminer_app_staging role — a separate role from DATABASE_URL,
# not the same credentials on a second pool (11 §4.2). The terms values are what
# consent rows are stamped with, frozen per deployment.
#
# BODY_PATH points at the text the client displays at signup, and startup checks
# that its sha256 equals CONSOLE_APP_TERMS_HASH — so the bytes users accept and
# the hash stamped onto their consent rows cannot drift apart. A mismatch, or an
# unreadable file, refuses to start. Terms live in ./terms/.
#
#   shasum -a 256 apps/console-api/terms/annotator-2026-07-25-teaser.txt
CONSOLE_APP_DATABASE_URL=
CONSOLE_APP_TERMS_POLICY_VERSION=
CONSOLE_APP_TERMS_PURPOSE=
CONSOLE_APP_TERMS_HASH=
CONSOLE_APP_TERMS_BODY_PATH=

# D1 观测镜像（dataminer-mirror）的凭据发布目标。
# 全给或全不给：半套配置会让镜像看起来接上了，实际每次发布都失败。
# 未配置时凭据会在 mirror_credential_outbox 里积压，D1 镜像拒绝所有设备
# （fail closed，不影响摄取面——那条路直接读 Cloud SQL）。
CONSOLE_MIRROR_D1_ACCOUNT_ID=
CONSOLE_MIRROR_D1_DATABASE_ID=
CONSOLE_MIRROR_D1_API_TOKEN=
CONSOLE_MIRROR_DRAIN_SECONDS=30
CONSOLE_MIRROR_DRAIN_BATCH=100

# --- production ---
# Production is supported and is strictly stricter than staging:
#   - CONSOLE_PROXY_TOKEN is required (without it Cloud Run answers /console/v1
#     from the open internet)
#   - CONSOLE_PUBLIC_ORIGIN must be https
#   - CONSOLE_MAIL_MODE=capture is refused, as it is in staging
#   - CONSOLE_SESSION_ABSOLUTE_MINUTES is capped at 12 hours
#   - CONSOLE_MAIL_FROM must be a diogenesmodel.com sender
# There is no mail allowlist requirement in production: real operators are on
# real addresses. Use a separate operator directory (its own DATABASE_URL) —
# staging operators must not be able to sign in to production.
#
# CONSOLE_ENV=production
# CONSOLE_PUBLIC_ORIGIN=https://console.diogenesmodel.com
# CONSOLE_PROXY_TOKEN=
# CONSOLE_MAIL_MODE=resend
# CONSOLE_MAIL_FROM=no-reply@mail.diogenesmodel.com
