# M2a is deliberately staging-only. Production startup is rejected in code.
DATAMINER_ENV=staging
# There is no shared ingest secret. `/v1/*` callers authenticate with a
# per-device credential issued by the console (docs/11 §10).
DATABASE_URL=postgres://dataminer_api:replace-me@127.0.0.1:5432/dataminer_staging

R2_ACCOUNT_ID=replace-me
R2_BUCKET=diogenes-model-training
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_PREFIX=raw-staging/v1/non-trainable/dataminer-api-staging

HOST=127.0.0.1
PORT=8080
R2_PRESIGN_TTL_SECONDS=900
R2_PART_SIZE_BYTES=67108864
R2_REQUEST_TIMEOUT_SECONDS=120
VERIFY_BATCH_SIZE=4
VERIFY_LEASE_SECONDS=900
PURGE_BATCH_SIZE=4
PURGE_LEASE_SECONDS=900
MULTIPART_COMPLETION_LEASE_SECONDS=300
ORPHAN_MULTIPART_GRACE_SECONDS=1200
STAGING_RETENTION_DAYS=30

# --- capture grant issuance (docs/26 §3/§5) ---
# Unset by default, and that is the fail-closed posture, not a TODO: without a
# signing key `POST /v1/capture-grants` is NOT REGISTERED AT ALL. The client
# reads the resulting 404 the same way it reads a 403 — "this machine has no
# grant for that game" — so certified recording stays fail-closed rather than
# erroring. There is no seed/dev fallback key on purpose: a compiled-in grant
# key would be a permanent "always yes" behind the last gate before certified
# recording.
#
# The key MUST be a different Cloud KMS Ed25519 key from the certified catalog
# key (DATAMINER_CERTIFIED_KMS_KEY). They rotate and revoke independently; a
# leak of one must not reach the other. Startup refuses if both name the same
# key. The key does not exist yet — creating it is a manual step outside this
# repository, and until then this whole surface is inert.
#
# The client must also pin the matching public key half as GRANT_SIGNING_ANCHOR
# (capture_grant.rs); a key here without that anchor there opens nothing.
#
# DATAMINER_CAPTURE_GRANT_KMS_KEY=projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>/cryptoKeyVersions/1
# DATAMINER_CAPTURE_GRANT_KEY_ID=dm-grant-kms-v1
# CAPTURE_GRANT_TTL_SECONDS=86400
# CAPTURE_GRANT_CLOCK_SKEW_SECONDS=60

# --- client behaviour logs export (docs/23 §6) ---
# Off by default. When enabled, the worker drains `client_event.recorded`
# outbox rows into gs://<LOGS_GCS_BUCKET>/<env>/client_events/ as Hive
# partitioned NDJSON.zst. There is no key material here: GCS auth is ADC —
# the Cloud Run service account (dataminer-log-exporter@) or an impersonated
# local ADC (`gcloud auth application-default login
# --impersonate-service-account=dataminer-log-exporter@hakkolite.iam.gserviceaccount.com`).
# LOGS_EXPORT_ENABLED=true
# LOGS_GCS_BUCKET=dataminer-logs
# LOGS_EXPORT_BATCH_SIZE=200
# LOGS_EXPORT_DRY_RUN=false

# --- production ---
# Production is a supported environment. It is not staging with a different
# label: R2_PREFIX has no default and RETENTION_DAYS must be stated (<= 365,
# the docs/00 consent ceiling; the 400-day R2 lifecycle in docs/06 is the
# backstop above it). Production currently admits the same dm-local-dev
# non-trainable RAW uploads as staging (#75's client uploader), under the
# mutually exclusive raw/v1/non-trainable/ namespace; the certified dm-1
# admission arrives with the signed-catalog line (docs/16 P4/P5). Enabling
# production does NOT make data trainable — clip_trainability still requires
# an active consent, an active grant, an approved catalog entry, and a QA pass.
#
# Production additionally requires DATAMINER_PROXY_TOKEN (>= 32 bytes). It is
# the edge gate, not a caller credential: production runs behind a Cloudflare
# Worker at api.diogenesmodel.com, and the Cloud Run origin behind it must admit
# allUsers (desktop clients hold per-device bearer tokens, not Google
# identities). The token is what makes the bare *.run.app URL useless — /v1/*
# answers 404 without it. The Worker holds the same value as a Worker secret.
#
# DATAMINER_ENV=production
# R2_BUCKET=diogenes-model-training
# R2_PREFIX=raw/v1/non-trainable/dataminer-api-production
# RETENTION_DAYS=365
# DATAMINER_PROXY_TOKEN=replace-me-with-32-plus-random-bytes
