{
  "rule": [
    {
      "action": { "type": "Delete" },
      "condition": { "age": 60, "matchesPrefix": ["staging/"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "age": 400, "matchesPrefix": ["production/"] }
    },
    {
      "action": { "type": "AbortIncompleteMultipartUpload" },
      "condition": { "age": 7 }
    }
  ]
}
